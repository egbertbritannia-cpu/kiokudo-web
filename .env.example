# LOCAL STAGING PREVIEW ONLY.
# Two processes: kiokudo-core (Fastify 4000) and kiokudo-web (Next.js 3000).
# Do not use KIOKUDO_STAGING_READ_ENABLED in a public deployment.
KIOKUDO_STAGING_READ_ENABLED=false
KIOKUDO_CORE_URL=http://127.0.0.1:4000
KIOKUDO_CORE_SERVICE_TOKEN=replace-this-with-a-long-random-value

# Phase 01 — single-owner login (server-only; set actual secrets in provider dashboard).
# Identifier is stable, 3-64 chars: letters, numbers, underscore or hyphen.
KIOKUDO_OWNER_SUBJECT=owner_kiokudo
# Session HMAC key: independent random 32+ characters, never NEXT_PUBLIC_*.
KIOKUDO_SESSION_SECRET=replace-with-independent-32-plus-random-characters
# Dedicated shared assertion signing key (same secret in Web and Core).
KIOKUDO_INTERNAL_ASSERTION_KEY=replace-with-another-32-plus-random-characters
# Format: 16-byte random salt as 32 hex chars : 64-byte scrypt digest as 128 hex chars.
# Generate locally; never commit plaintext password or real hash.
KIOKUDO_LOGIN_PASSWORD_SCRYPT=

# PUBLIC WEB -> VERIFIED STAGING CORE READ (opt-in only; never production DB).
# When running a production Next build, localhost Core connections remain refused.
KIOKUDO_REMOTE_STAGING_READ_ENABLED=false
# Exact DNS hostname, without scheme/port/path. HTTPS 443 only.
KIOKUDO_CORE_ALLOWED_HOST=staging-core.example.org
# For remote staging only, set KIOKUDO_CORE_URL=https://your-allowed-host

# Public deployment login/logout same-origin and CSRF gate (exact HTTPS origin).
# Required only for real public staging deployment, NOT for localhost development.
KIOKUDO_WEB_PUBLIC_ORIGIN=https://your-kiokudo-host.example.org
